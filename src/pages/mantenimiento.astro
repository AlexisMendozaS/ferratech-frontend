---
/**
 * Se muestra (con estado 503) cuando una página pública no puede armarse porque el backend no
 * responde. Google entiende el 503 como algo temporal y no desindexa el sitio. Ver middleware.
 */
import Publico from '@/layouts/Publico.astro'
import { numeroWhatsApp } from '@/lib/contacto'

const whatsapp = numeroWhatsApp()
---

<Publico titulo="Estamos actualizando el catálogo" noindex sinBuscador>
  <div class="mx-auto max-w-xl px-4 py-20 text-center sm:px-6">
    <h1 class="text-3xl font-bold">Estamos actualizando el catálogo</h1>
    <p class="mt-3 text-muted-foreground">Vuelve a intentarlo en un par de minutos. Si es urgente, escríbenos y te cotizamos al momento.</p>
    <div class="mt-6 flex flex-wrap justify-center gap-3">
      <a href={Astro.url.pathname + Astro.url.search} class="rounded-md bg-secondary px-4 py-2 font-semibold text-secondary-foreground hover:bg-secondary/90">Reintentar</a>
      {whatsapp && <a href={`https://wa.me/${whatsapp}`} target="_blank" rel="noopener noreferrer" class="rounded-md bg-primary px-4 py-2 font-semibold text-primary-foreground hover:bg-primary/90">Cotizar por WhatsApp</a>}
    </div>
  </div>
</Publico>
