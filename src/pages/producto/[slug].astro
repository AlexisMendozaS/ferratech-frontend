---
/**
 * Página de producto (INI-007): HTML completo para Google, sin precio, marca ni proveedor
 * (DEC-012). Acepta un slug anterior o el id viejo y redirige (301) a la URL actual.
 */
import { CheckCircle2 } from 'lucide-react'

import Publico from '@/layouts/Publico.astro'
import TarjetaProducto from '@/componentes-astro/TarjetaProducto.astro'
import AgregarACotizacion from '@/islas/AgregarACotizacion'
import { api } from '@/lib/api'
import { numeroWhatsApp } from '@/lib/contacto'
import { migas, producto as productoLd, recortar } from '@/lib/seo'
import type { ProductoTarjeta } from '@/types/producto'

const { slug = '' } = Astro.params
const p = await api.producto(slug)
if (!p) {
  Astro.response.status = 404
  return Astro.rewrite('/404')
}
if (p.slug !== slug) return Astro.redirect(`/producto/${p.slug}`, 301)

const categorias = await api.categorias()
const porId = new Map(categorias.map((c) => [c.id, c]))
const familia = p.categoria_principal ? porId.get(p.categoria_principal) : undefined
const seccion = familia?.padre ? porId.get(familia.padre) : undefined

// Relacionados: los elegidos en el panel y, si faltan, otros de la misma familia.
const elegidos = (await Promise.all([...p.alternativas, ...p.relacionados].slice(0, 8).map((id) => api.producto(id).catch(() => null))))
  .filter((x) => x !== null)
  .map((r) => ({
    id: r.id,
    slug: r.slug,
    nombre: r.nombre,
    descripcion_corta: r.descripcion_corta,
    imagen: r.galeria[0] ?? null,
    categoria_principal: r.categoria_principal,
    disponibilidad: r.disponibilidad,
    num_variantes: r.variantes.length,
  })) as ProductoTarjeta[]
let relacionados = elegidos
if (relacionados.length < 4 && familia) {
  const misma = await api.buscar({ categoria: familia.slug, limit: 8 })
  const vistos = new Set([p.id, ...relacionados.map((r) => r.id)])
  relacionados = [...relacionados, ...misma.productos.filter((r) => !vistos.has(r.id))].slice(0, 8)
}

const origen = (Astro.site?.origin ?? Astro.url.origin).replace(/\/$/, '')
const ruta = [
  { nombre: 'Inicio', ruta: '/' },
  ...(seccion ? [{ nombre: seccion.nombre, ruta: `/categoria/${seccion.slug}` }] : []),
  ...(familia ? [{ nombre: familia.nombre, ruta: `/categoria/${familia.slug}` }] : []),
  { nombre: p.nombre, ruta: `/producto/${p.slug}` },
]
const galeria = [...p.galeria].sort((a, b) => a.orden - b.orden)
const parrafos = (p.descripcion ?? '').split(/\n\s*\n/).map((t) => t.trim()).filter(Boolean)

// Tabla de medidas: una fila por variante, con los ejes y los datos técnicos de cada una.
const clavesVariante = [...new Set(p.variantes.flatMap((v) => v.especificaciones.map((f) => `${f.clave}${f.unidad ? ` (${f.unidad})` : ''}`)))]
const celda = (v: (typeof p.variantes)[number], clave: string) => {
  const f = v.especificaciones.find((f) => `${f.clave}${f.unidad ? ` (${f.unidad})` : ''}` === clave)
  return f ? f.valor : '—'
}
const conTablaDeMedidas = p.variantes.length > 1 && p.ejes.length > 0

Astro.response.headers.set('Cache-Control', 'public, s-maxage=300, stale-while-revalidate=86400')
---

<Publico
  titulo={p.meta_titulo ?? p.nombre}
  descripcion={p.meta_descripcion ?? recortar(p.descripcion_corta ?? p.descripcion)}
  canonica={`/producto/${p.slug}`}
  imagen={galeria[0]?.url}
  tipo="product"
  jsonld={[productoLd(origen, p, familia?.nombre ?? null), migas(origen, ruta)]}
>
  <div class="mx-auto max-w-7xl px-4 pt-6 sm:px-6" data-vista-producto={p.slug}>
    <nav aria-label="Ruta" class="text-sm text-muted-foreground">
      <ol class="flex flex-wrap items-center gap-1">
        {
          ruta.map((paso, i) => (
            <li class="flex items-center gap-1">
              {i > 0 && <span aria-hidden="true">/</span>}
              {i < ruta.length - 1 ? (
                <a href={paso.ruta} class="hover:text-foreground hover:underline">
                  {paso.nombre}
                </a>
              ) : (
                <span aria-current="page" class="text-foreground">
                  {paso.nombre}
                </span>
              )}
            </li>
          ))
        }
      </ol>
    </nav>

    <div class="mt-6 grid gap-8 lg:grid-cols-[1fr_380px]">
      <section aria-label="Imágenes" class="grid gap-3 sm:grid-cols-[72px_1fr]" data-galeria>
        {
          galeria.length > 1 && (
            <ul class="order-2 flex gap-2 overflow-x-auto sm:order-1 sm:flex-col">
              {galeria.map((img, i) => (
                <li>
                  <button
                    type="button"
                    data-miniatura={i}
                    aria-label={`Ver imagen ${i + 1}: ${img.alt}`}
                    class:list={['size-16 overflow-hidden rounded-md border bg-white p-1', i === 0 && 'ring-2 ring-primary']}
                  >
                    <img src={img.url} alt="" width="64" height="64" loading="lazy" class="size-full object-contain" />
                  </button>
                </li>
              ))}
            </ul>
          )
        }
        <div class:list={['order-1 aspect-square overflow-hidden rounded-lg border bg-white sm:order-2', galeria.length <= 1 && 'sm:col-span-2']}>
          {
            galeria.length > 0 ? (
              galeria.map((img, i) => (
                <img
                  src={img.url}
                  alt={img.alt}
                  width="1000"
                  height="1000"
                  data-imagen={i}
                  loading={i === 0 ? 'eager' : 'lazy'}
                  fetchpriority={i === 0 ? 'high' : 'auto'}
                  class:list={['size-full object-contain p-4', i > 0 && 'hidden']}
                />
              ))
            ) : (
              <div class="flex size-full items-center justify-center text-muted-foreground">Imagen próximamente</div>
            )
          }
        </div>
      </section>

      <aside class="self-start rounded-lg border bg-card p-5 shadow-sm lg:sticky lg:top-24">
        <h1 class="text-2xl font-bold leading-tight">{p.nombre}</h1>
        {p.descripcion_corta && <p class="mt-2 text-sm text-muted-foreground">{p.descripcion_corta}</p>}
        {
          p.disponibilidad === 'descontinuado' ? (
            <p class="mt-4 rounded-md bg-muted p-3 text-sm">Este producto ya no se surte. Revisa las alternativas de abajo o pide una cotización.</p>
          ) : (
            <p class="mt-3 text-sm font-medium text-green-700">{p.disponibilidad === 'bajo_pedido' ? 'Bajo pedido' : 'Disponible para cotizar'}</p>
          )
        }
        <hr class="my-5" />
        <AgregarACotizacion
          client:load
          id={p.id}
          slug={p.slug}
          nombre={p.nombre}
          imagen={galeria[0]?.url ?? null}
          ejes={p.ejes}
          variantes={p.variantes}
          whatsapp={numeroWhatsApp()}
        />
      </aside>
    </div>

    <div class="mt-12 grid gap-10 lg:grid-cols-[1fr_380px]">
      <div class="min-w-0 space-y-10">
        {
          parrafos.length > 0 && (
            <section aria-labelledby="t-descripcion">
              <h2 id="t-descripcion" class="text-xl font-bold">
                Descripción
              </h2>
              <div class="mt-3 space-y-3 leading-relaxed">
                {parrafos.map((t) => (
                  <p>{t}</p>
                ))}
              </div>
            </section>
          )
        }

        {
          conTablaDeMedidas && (
            <section aria-labelledby="t-medidas">
              <h2 id="t-medidas" class="text-xl font-bold">
                Medidas y presentaciones
              </h2>
              <div class="mt-3 overflow-x-auto rounded-lg border">
                <table class="w-full min-w-max text-sm">
                  <thead class="bg-muted text-left">
                    <tr>
                      {p.ejes.map((e) => (
                        <th scope="col" class="px-3 py-2 font-semibold">
                          {e.nombre}
                        </th>
                      ))}
                      {clavesVariante.map((c) => (
                        <th scope="col" class="px-3 py-2 font-semibold">
                          {c}
                        </th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {p.variantes.map((v) => (
                      <tr class="border-t">
                        {p.ejes.map((e) => (
                          <th scope="row" class="px-3 py-2 text-left font-medium">
                            {v.valores[e.nombre]}
                          </th>
                        ))}
                        {clavesVariante.map((c) => (
                          <td class="px-3 py-2 tabular-nums">{celda(v, c)}</td>
                        ))}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </section>
          )
        }

        {
          p.especificaciones.length > 0 && (
            <section aria-labelledby="t-especificaciones">
              <h2 id="t-especificaciones" class="text-xl font-bold">
                Especificaciones
              </h2>
              <div class="mt-3 grid gap-4 md:grid-cols-2">
                {p.especificaciones.map((g) => (
                  <div class="overflow-hidden rounded-lg border">
                    <h3 class="bg-muted px-3 py-2 font-semibold">{g.grupo}</h3>
                    <dl class="divide-y text-sm">
                      {g.filas.map((f) => (
                        <div class="grid grid-cols-2 gap-3 px-3 py-2">
                          <dt class="text-muted-foreground">{f.clave}</dt>
                          <dd>
                            {f.valor}
                            {f.unidad ? ` ${f.unidad}` : ''}
                          </dd>
                        </div>
                      ))}
                    </dl>
                  </div>
                ))}
              </div>
            </section>
          )
        }
      </div>

      <div class="space-y-8">
        {
          p.ventajas.length > 0 && (
            <section aria-labelledby="t-ventajas">
              <h2 id="t-ventajas" class="text-lg font-bold">
                Ventajas
              </h2>
              <ul class="mt-3 space-y-2 text-sm">
                {p.ventajas.map((v) => (
                  <li class="flex gap-2">
                    <CheckCircle2 className="mt-0.5 size-4 shrink-0 text-green-600" aria-hidden="true" />
                    {v}
                  </li>
                ))}
              </ul>
            </section>
          )
        }
        {
          p.aplicaciones.length > 0 && (
            <section aria-labelledby="t-usos">
              <h2 id="t-usos" class="text-lg font-bold">
                Usos
              </h2>
              <ul class="mt-3 flex flex-wrap gap-2 text-sm">
                {p.aplicaciones.map((a) => (
                  <li class="rounded-full bg-muted px-3 py-1">{a}</li>
                ))}
              </ul>
            </section>
          )
        }
      </div>
    </div>

    {
      relacionados.length > 0 && (
        <section class="mt-14" aria-labelledby="t-relacionados">
          <h2 id="t-relacionados" class="text-xl font-bold">
            {p.disponibilidad === 'descontinuado' ? 'Alternativas' : 'También te puede servir'}
          </h2>
          <div class="mt-4 grid grid-cols-2 gap-3 sm:gap-5 md:grid-cols-3 lg:grid-cols-4">
            {relacionados.slice(0, 8).map((r) => (
              <TarjetaProducto producto={r} />
            ))}
          </div>
        </section>
      )
    }
  </div>
</Publico>

<script>
  // Galería: las miniaturas cambian la imagen grande sin recargar.
  for (const galeria of document.querySelectorAll<HTMLElement>('[data-galeria]')) {
    const imagenes = galeria.querySelectorAll<HTMLImageElement>('[data-imagen]')
    const miniaturas = galeria.querySelectorAll<HTMLButtonElement>('[data-miniatura]')
    miniaturas.forEach((boton) =>
      boton.addEventListener('click', () => {
        const i = Number(boton.dataset.miniatura)
        imagenes.forEach((img, j) => img.classList.toggle('hidden', j !== i))
        miniaturas.forEach((b, j) => b.classList.toggle('ring-2', j === i))
        miniaturas.forEach((b, j) => b.classList.toggle('ring-primary', j === i))
      }),
    )
  }
</script>
