---
/** Tarjeta de producto en listados: sin precio (DEC-012), con llamada a cotizar. */
import type { ProductoTarjeta } from '@/types/producto'
import { tarjeta } from '@/lib/imagenes'

interface Props {
  producto: ProductoTarjeta
  /** Las primeras tarjetas de la página se cargan sin esperar (mejor LCP). */
  prioridad?: boolean
  /** En resultados de búsqueda: para registrar en qué posición se hizo clic (INI-009). */
  busqueda?: { q: string; posicion: number }
  /** Nivel del título: h2 si la lista va justo debajo del h1 de la página; h3 si hay un h2 antes. */
  nivel?: 2 | 3
}

const { producto: p, prioridad = false, busqueda, nivel = 3 } = Astro.props
const Titulo = nivel === 2 ? 'h2' : 'h3'
const href = `/producto/${p.slug}`
const foto = p.imagen ? tarjeta(p.imagen.url) : null
---

<article
  class="group flex flex-col overflow-hidden rounded-lg border bg-card shadow-sm transition-shadow hover:shadow-md"
  data-resultado={busqueda ? p.slug : undefined}
  data-q={busqueda?.q}
  data-posicion={busqueda?.posicion}
>
  <a href={href} class="relative block aspect-square bg-white" tabindex="-1" aria-hidden="true">
    {
      foto ? (
        <img
          src={foto.src}
          srcset={foto.srcset}
          sizes={foto.sizes}
          alt=""
          width="500"
          height="500"
          loading={prioridad ? 'eager' : 'lazy'}
          fetchpriority={prioridad ? 'high' : 'auto'}
          decoding="async"
          class="size-full object-contain p-4 transition-transform duration-300 group-hover:scale-[1.03]"
        />
      ) : (
        <span class="flex size-full items-center justify-center text-sm text-muted-foreground">Imagen próximamente</span>
      )
    }
    {p.disponibilidad === 'bajo_pedido' && <span class="absolute left-2 top-2 rounded bg-muted px-2 py-0.5 text-xs font-medium">Bajo pedido</span>}
  </a>
  <div class="flex flex-1 flex-col gap-2 p-4">
    <Titulo class="font-semibold leading-snug">
      <a href={href} class="hover:underline">{p.nombre}</a>
    </Titulo>
    {p.descripcion_corta && <p class="line-clamp-2 text-sm text-muted-foreground">{p.descripcion_corta}</p>}
    <div class="mt-auto flex items-center justify-between gap-2 pt-2">
      <span class="text-xs text-muted-foreground">{p.num_variantes > 1 ? `${p.num_variantes} opciones` : ' '}</span>
      <a href={href} class="rounded-md bg-secondary px-3 py-1.5 text-sm font-semibold text-secondary-foreground hover:bg-secondary/90">
        Cotizar
      </a>
    </div>
  </div>
</article>
